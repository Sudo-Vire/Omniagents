, y: 3}, {x: 1, y: 2}\\n    ];\\n\\n    let headIndex = 0;\\n    const snakeLength = 5;\\n    let food = { x: 3, y: 3 };\\n\\n    const interval = setInterval(() => {\\n      if (!document.body.contains(canvas)) {\\n        clearInterval(interval);\\n        return;\\n      }\\n      const style = getComputedStyle(document.body);\\n      const ink = style.getPropertyValue('--ink').trim() || '#090b0a';\\n      const line = style.getPropertyValue('--line').trim() || '#1b221d';\\n      const green = style.getPropertyValue('--green').trim() || '#20ef4f';\\n      const cyan = style.getPropertyValue('--cyan').trim() || '#91f3a8';\\n\\n      headIndex = (headIndex + 1) % path.length;\\n      let snake = [];\\n      for (let i = 0; i < snakeLength; i++) {\\n        let idx = (headIndex - i + path.length) % path.length;\\n        snake.push(path[idx]);\\n      }\\n\\n      ctx.fillStyle = ink;\\n      ctx.fillRect(0, 0, canvas.width, canvas.height);\\n\\n      ctx.strokeStyle = line;\\n      ctx.lineWidth = 0.5;\\n      for (let x = 0; x <= canvas.width; x += cellSize) {\\n        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();\\n      }\\n      for (let y = 0; y <= canvas.height; y += cellSize) {\\n        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();\\n      }\\n\\n      ctx.fillStyle = cyan;\\n      ctx.shadowColor = cyan;\\n      ctx.shadowBlur = 6;\\n      ctx.fillRect(food.x * cellSize + 1, food.y * cellSize + 1, cellSize - 2, cellSize - 2);\\n      ctx.shadowBlur = 0;\\n\\n      snake.forEach((part, idx) => {\\n        ctx.fillStyle = idx === 0 ? cyan : green;\\n        if (idx === 0) {\\n          ctx.shadowColor = green;\\n          ctx.shadowBlur = 4;\\n        }\\n        ctx.fillRect(part.x * cellSize + 1, part.y * cellSize + 1, cellSize - 2, cellSize - 2);\\n        if (idx === 0) ctx.shadowBlur = 0;\\n      });\\n    }, 90);\\n  }\\n});\\n\\nconst originalRenderJuegos = View.renderJuegos;\\nView.ren
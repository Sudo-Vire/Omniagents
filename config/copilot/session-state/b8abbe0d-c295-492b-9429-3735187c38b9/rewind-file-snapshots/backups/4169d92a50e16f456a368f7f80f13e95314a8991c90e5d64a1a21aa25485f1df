package poker.controller;

import poker.model.Jugador;
import poker.model.Carta;
import poker.service.JugadorService;

public class JugadorController {

    private JugadorService jugadorService;

    public JugadorController() {
        this.jugadorService = new JugadorService();
    }

    // Crear un nuevo jugador
    public Jugador crearJugador(String nombre, int saldoInicial) {
        if (nombre == null || nombre.isEmpty()) {
            throw new IllegalArgumentException("El nombre no puede estar vacío");
        }
        if (saldoInicial <= 0) {
            throw new IllegalArgumentException("El saldo inicial debe ser mayor a 0");
        }
        return new Jugador(nombre, saldoInicial);
    }

    // Mostrar la mano del jugador
    public void mostrarMano(Jugador jugador) {
        if (jugador == null) {
            throw new IllegalArgumentException("Jugador no inicializado");
        }
        jugadorService.mostrarMano(jugador);
    }

    // Mostrar el estado del jugador
    public void mostrarEstado(Jugador jugador) {
        if (jugador == null) {
            throw new IllegalArgumentException("Jugador no inicializado");
        }
        jugadorService.mostrarEstadoJugador(jugador);
    }

    // Recibir una carta
    public void recibirCarta(Jugador jugador, Carta carta) {
        if (jugador == null || carta == null) {
            throw new IllegalArgumentException("Jugador o carta no pueden ser nulos");
        }
        jugador.recibirCarta(carta);
    }

    // Ganar dinero
    public void ganar(Jugador jugador, int cantidad) {
        if (jugador == null || cantidad < 0) {
            throw new IllegalArgumentException("Datos inválidos");
        }
        jugador.ganar(cantidad);
    }

    // Establecer saldo
    public void setSaldo(Jugador jugador, int saldo) {
        if (jugador == null || saldo < 0) {
            throw new IllegalArgumentException("Datos inválidos");
        }
        jugador.setSaldo(saldo);
    }

    // Iniciar nueva mano
    public void nuevaMano(Jugador jugador) {
        if (jugador == null) {
            throw new IllegalArgumentException("Jugador no inicializado");
        }
        jugador.nuevaMano();
    }

    // Métodos adicionales de estado
    public void setEnJuego(Jugador jugador, boolean enJuego) {
        if (jugador == null) {
            throw new IllegalArgumentException("Jugador no inicializado");
        }
        jugador.setEnJuego(enJuego);
    }

    public void setHaApostado(Jugador jugador, boolean haApostado) {
        if (jugador == null) {
            throw new IllegalArgumentException("Jugador no inicializado");
        }
        jugador.setHaApostado(haApostado);
    }

    public void setVaAllIn(Jugador jugador, boolean vaAllIn) {
        if (jugador == null) {
            throw new IllegalArgumentException("Jugador no inicializado");
        }
        jugador.setVaAllIn(vaAllIn);
    }
}
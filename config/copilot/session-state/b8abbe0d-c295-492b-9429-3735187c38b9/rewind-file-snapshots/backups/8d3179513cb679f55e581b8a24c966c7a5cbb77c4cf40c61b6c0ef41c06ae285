package poker;

import poker.model.Jugador;

import java.util.List;

/**
 * Compatibility launcher retained for users of older releases.
 */
@Deprecated
public final class Poker {
    private Poker() {
    }

    public static void main(String[] args) {
        Juego.main(args);
    }

    /**
     * Kept for source compatibility with the old reflection-based tests.
     */
    private static boolean todosAllInOSoloUnoActivo(List<Jugador> jugadores) {
        int activos = 0;
        boolean alguienPuedeApostar = false;
        for (Jugador jugador : jugadores) {
            if (jugador.isEnJuego()) {
                activos++;
                if (!jugador.isVaAllIn() && jugador.getSaldo() > 0) {
                    alguienPuedeApostar = true;
                }
            }
        }
        return !alguienPuedeApostar || activos <= 1;
    }
}
